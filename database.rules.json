{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "farms": {
      "$farmId": {
        ".read": "auth != null && data.child('ownerId').val() === auth.uid",
        ".write": "auth != null && (!data.exists() || data.child('ownerId').val() === auth.uid)"
      }
    },
    "devices": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "gate": {
          ".validate": "newData.hasChildren(['command'])"
        },
        "system": {
          "lastSeen": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}
